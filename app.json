{
  "expo": {
    "newArchEnabled": true,
    "name": "bianco.ai",
    "slug": "bianco-ai",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "scheme": "bianco",
    "platforms": [
      "ios",
      "android"
    ],
    "experiments": {
      "tsconfigPaths": true
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mmdev13.biancoai",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "softwareKeyboardLayoutMode": "pan",
      "predictiveBackGestureEnabled": false,
      "package": "com.mmdev13.biancoai"
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "36162c2f-7925-496d-b3fd-aa091cc155e3"
      }
    }
  }
}
